# Variáveis de Ambiente - BloxVault
# 
# Copie este arquivo para ".env" e preencha com suas credenciais reais.
# O arquivo ".env" NUNCA deve ser enviado ao GitHub (já está no .gitignore).
#
# Para obter a chave do Asaas:
# 1. Acesse: https://app.asaas.com
# 2. Vá em: Configurações > Integrações > Chaves de API
# 3. Gere uma nova chave e cole abaixo

# Chave de API do Asaas (PRODUÇÃO)
ASAAS_API_KEY=

# Ambiente do Asaas: "production" ou "sandbox"
# Use "sandbox" para testes: https://sandbox.asaas.com
ASAAS_ENV=production
